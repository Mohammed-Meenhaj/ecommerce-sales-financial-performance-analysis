table 'ecommerce_analytics ecommerce_sales_clean'
	lineageTag: 1422f32d-fa1e-41f1-8d0b-1dd0916e39db

	measure 'Total Revenue' = SUM('ecommerce_analytics ecommerce_sales_clean'[completed_sales_bdt])
		formatString: "BDT "#,0
		lineageTag: 3275eb00-9b52-47ee-8c9e-ddf1430c856c

	measure 'Total COGS' = SUM('ecommerce_analytics ecommerce_sales_clean'[completed_cogs_bdt])
		formatString: "BDT "#,0
		lineageTag: 23ca89ed-7d9e-4739-840c-ab31dc47575b

	measure 'Gross Profit' = SUM('ecommerce_analytics ecommerce_sales_clean'[completed_profit_bdt])
		formatString: "BDT "#,0
		lineageTag: 618b72ec-60c9-4a1b-8742-24853069541c

	measure 'Profit Margin %' = DIVIDE([Gross Profit], [Total Revenue], 0)
		formatString: 0.00%
		lineageTag: d2015f81-65e8-4883-9013-6b54bda913ac

	measure 'Total Orders' = COUNTROWS('ecommerce_analytics ecommerce_sales_clean')
		formatString: #,0
		lineageTag: f3f16489-cfdb-4c84-948a-33ade3ba6e64

